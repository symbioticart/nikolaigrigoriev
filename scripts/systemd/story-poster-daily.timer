[Unit]
Description=Кадр дня — каждое утро после того, как daily-89 записал его в архив

[Timer]
# daily-89 снимает кадр в 08:00 UTC. Планировщик GitHub опаздывает — по своей же
# документации от 26 до 218 минут, то есть кадр ложится в архив вплоть до 11:38 UTC,
# и деплою на Render после этого нужно ещё несколько минут. 12:30 — после всего этого.
# Зона указана явно: без неё systemd берёт локальную зону машины, и постер на
# сервере в Мадриде ушёл бы в 10:30 UTC — за час до того, как кадр появится.
OnCalendar=*-*-* 12:30:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
